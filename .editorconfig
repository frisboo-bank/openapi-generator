# EditorConfig: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.go]
indent_style = tab

[Makefile]
indent_style = tab

[*.{yaml,yml}]
indent_style = space
indent_size = 2

[*.proto]
indent_style = space
indent_size = 2

[*.{ts,tsx,js,jsx,mjs,cjs}]
indent_style = space
indent_size = 2

[*.{css,scss,sass,less,html,json}]
indent_style = space
indent_size = 2

[*.sql]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[.gitignore]
indent_style = space

[*.toml]
indent_style = space
indent_size = 2
